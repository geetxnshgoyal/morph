<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs on any OS against the portable engine; the Windows-only pieces (OCR, faces, PDF rendering,
       Media Foundation) are covered by the CI build, not by these tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Morph.Core/Morph.Core.csproj" />
  </ItemGroup>

</Project>
